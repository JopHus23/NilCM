<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NilCM.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
        x:Class="NilCM.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="NilCM"
        Width="640" Height="480"
        MinWidth="480" MinHeight="360">

    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <TextBox Width="200" Watermark="歌曲 ID（如 186016）" Text="{Binding TrackIdText}" />
            <Button Content="获取歌词" Command="{Binding LoadLyricCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="播放" Command="{Binding PlayCommand}" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,10,0,10" Opacity="0.65" Text="{Binding StatusText}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="暂停" Command="{Binding PauseCommand}" />
            <Button Content="继续" Command="{Binding ResumeCommand}" />
            <Button Content="停止" Command="{Binding StopPlaybackCommand}" />
            <TextBlock Text="音量" VerticalAlignment="Center" Opacity="0.6" />
            <Slider Width="110" Minimum="0" Maximum="100" Value="{Binding VolumePercent}" />
            <TextBlock Text="{Binding NowPlayingText}" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,10,0,10">
            <ProgressBar Width="240" Height="4" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
            <TextBlock Text="{Binding PositionText}" Opacity="0.6" FontSize="11" />
        </StackPanel>

        <ListBox Grid.Row="4" ItemsSource="{Binding LyricLines}" />

        <TextBlock Grid.Row="5" Margin="0,10,0,0" Opacity="0.4" FontSize="11"
                   Text="NilCM · 学习用途 · 架构与决策见 ARCHITECTURE.md" />
    </Grid>
</Window>

