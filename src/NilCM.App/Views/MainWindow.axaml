<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NilCM.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
        x:Class="NilCM.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="NilCM"
        Width="640" Height="480"
        MinWidth="480" MinHeight="360">

    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <TextBox Width="200" Watermark="歌曲 ID（如 186016）" Text="{Binding TrackIdText}" />
            <Button Content="获取歌词" Command="{Binding LoadLyricCommand}" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,10,0,10" Opacity="0.65" Text="{Binding StatusText}" />

        <ListBox Grid.Row="2" ItemsSource="{Binding LyricLines}" />

        <TextBlock Grid.Row="3" Margin="0,10,0,0" Opacity="0.4" FontSize="11"
                   Text="NilCM · 学习用途 · 架构与决策见 ARCHITECTURE.md" />
    </Grid>
</Window>

